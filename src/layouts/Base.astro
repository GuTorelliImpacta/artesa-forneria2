---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import FloatingMobileCTA from '../components/FloatingMobileCTA.astro';
import Footer from '../components/Footer.astro';
import { H } from '../lib/site';

interface Props {
  titulo: string; descricao: string; caminho: string; imagem?: string; noindex?: boolean;
  jsonld?: object[]; atual?: string; evento?: string; hero?: boolean;
}
const { titulo, descricao, caminho, imagem, noindex, jsonld = [], atual = caminho, evento, hero = false } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#29231E" />
    <meta name="format-detection" content="telephone=no" />
    <Seo titulo={titulo} descricao={descricao} caminho={caminho} imagem={imagem} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/cormorant-garamond-var.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {jsonld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script src="/ga-init.js" data-ga-id={gaId}></script>}
  </head>
  <body data-evento={evento} class:list={{ 'sem-hero': !hero }}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <Header atual={atual} transparente={hero} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <FloatingMobileCTA />
    <script id="dados-horarios" type="application/json" set:html={JSON.stringify(H)} />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
