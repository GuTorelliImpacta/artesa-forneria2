---
// Botões de conversão reutilizáveis.
import Icone from './Icone.astro';
import { waLink, deliveryUrl } from '../lib/site';
interface Props { cardapio?: boolean; delivery?: boolean; centro?: boolean; texto?: string; origem?: string }
const { cardapio = false, delivery = false, centro = false, texto = 'Reservar pelo WhatsApp', origem } = Astro.props;
---
<div class:list={['acoes', { centro }]}>
  <a class="btn btn-primario" href={waLink()} target="_blank" rel="noopener noreferrer" data-umami-event="click_whatsapp" data-umami-event-origem={origem}>
    <Icone nome="chat" />{texto}
  </a>
  {cardapio && <a class="btn btn-secundario" href="/cardapio/">Ver cardápio</a>}
  {delivery && deliveryUrl && (
    <a class="btn btn-secundario" href={deliveryUrl} target="_blank" rel="noopener noreferrer" data-umami-event="click_delivery">Pedir delivery</a>
  )}
</div>
