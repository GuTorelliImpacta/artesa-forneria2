---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata; alt: string; sizes: string; widths?: number[];
  prioridade?: boolean; class?: string; quality?: number;
}
const { src, alt, sizes, widths, prioridade = false, class: cls, quality } = Astro.props;
const w = widths ?? [320, 480, 640, 800, 1000].filter((x) => x <= src.width);
---
<Picture
  src={src} alt={alt} sizes={sizes} widths={w} formats={['avif', 'webp']} fallbackFormat="jpg"
  loading={prioridade ? 'eager' : 'lazy'} fetchpriority={prioridade ? 'high' : 'auto'} decoding={prioridade ? 'sync' : 'async'}
  class={cls} quality={quality} width={src.width} height={src.height}
/>
