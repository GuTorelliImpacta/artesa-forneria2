---
import Icone from './Icone.astro';
import logo from '../assets/logo-disco.png';
import { Image } from 'astro:assets';
import { config, H } from '../lib/site';
import { fmtHora } from '../lib/horarios';
interface Props { atual: string }
const { atual } = Astro.props;
const links = [
  { href: '/cardapio/', rotulo: 'Cardápio' },
  { href: '/nossa-casa/', rotulo: 'Nossa casa' },
  { href: '/contato/', rotulo: 'Contato' },
];
const qui = H.semana.find((d) => d.dia === 4)!;
---
<div class="topo" id="topo">
  <div class="faixa-status" data-status data-aberto="nao">
    <a href="/contato/#horarios"><span class="ponto" aria-hidden="true"></span><span data-status-txt>Quinta a domingo · ver horários</span></a>
  </div>
  <div class="container cab">
    <a class="marca" href="/" aria-label={`${config.nome}, página inicial`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
      <span>{config.nome}</span>
    </a>
    <div class="cab-acoes">
      <nav class="nav-d" aria-label="Principal">
        {links.map((l) => <a class="nl" href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.rotulo}</a>)}
      </nav>
      <a class="btn btn-primario btn-pequeno" href="/contato/#reservar" data-umami-event="click_reservar_topo">Reservar</a>
      <details class="nav-m">
        <summary aria-label="Menu"><span>Menu</span></summary>
        <nav class="painel" aria-label="Menu principal">
          <a href="/">Início</a>
          {links.map((l) => <a href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.rotulo}</a>)}
        </nav>
      </details>
    </div>
  </div>
</div>
